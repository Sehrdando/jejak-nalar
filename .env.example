# ==========================================
# JEJAK NALAR - ENVIRONMENT CONFIGURATION
# ==========================================
# Salin file ini menjadi .env dan isi nilai aslinya.
# JANGAN PERNAH mengunggah file .env asli ke GitHub!

# Google Gemini API Key (Dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Frontend API URL (Default lokal)
VITE_API_BASE_URL=http://localhost:8000
